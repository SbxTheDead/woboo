{
  "name": "woboo",
  "version": "0.1.0",
  "private": true,
  "description": "A body for your AI. Give Woboo a task; it operates your PC, drives your coding tools, and tests the work before handing it back.",
  "author": "Rayane Sbaa <jbeyer52777@protonmail.com> (SbxTheDead)",
  "license": "MIT",
  "type": "module",
  "bin": {
    "woboo": "./woboo.mjs",
    "wobo": "./woboo.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node woboo.mjs widget",
    "widget": "electron desktop/main.mjs",
    "panel": "node woboo.mjs up",
    "doctor": "node woboo.mjs doctor",
    "selftest": "node woboo.mjs selftest",
    "test": "node --experimental-test-module-mocks --test --test-concurrency=1 \"test/*.test.mjs\"",
    "test:live": "node --experimental-test-module-mocks --test --test-concurrency=1 \"test/*.test.mjs\" \"test/live/*.test.mjs\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.72.0"
  },
  "devDependencies": {
    "electron": "^43.2.0"
  }
}
