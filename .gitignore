node_modules/
*.log

# Wobo's runtime state normally lives in ~/.wobo, but never commit a stray copy:
# owner.key is a credential and shots/ are pictures of your screen.
.wobo/
owner.key
secrets.json
journal.jsonl
shots/
memory/
STOP

# Personal documents, never source.
resume.txt

.env
.env.*

.DS_Store
Thumbs.db
desktop.ini

# Mission artifacts — output Woboo produced, not source.
elephant_research/
*.pdf

research/
*_research/
# Documents Woboo writes land in the workspace root; source HTML lives in desktop/.
/*.html

# Scratch space for mission output.
tmp/
internship_output/
*_output/
